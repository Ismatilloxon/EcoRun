{
  "name": "@ecorun/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "build:mobile": "VITE_API_URL=${MOBILE_API_URL:-http://localhost:8080} vite build --outDir dist-mobile --emptyOutDir",
    "ios": "npm run build:mobile && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/leaflet": "^1.9.15",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.0.3"
  }
}
