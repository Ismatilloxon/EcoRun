{
  "name": "ecorun",
  "private": true,
  "version": "0.1.0",
  "description": "EcoRun — social running + eco-points platform (Tashkent MVP)",
  "type": "module",
  "workspaces": ["server", "web", "bot"],
  "engines": { "node": ">=22.18" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:migrate": "npm run migrate -w server",
    "db:seed": "npm run seed -w server",
    "db:reset": "npm run reset -w server",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w web",
    "start": "node scripts/start.mjs",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w server && npm run typecheck -w bot",
    "test": "npm test -w server"
  }
}
