# ---- Core ----
NODE_ENV=development
PORT=8080
# Public URL of the web app (used in links sent by the bot, calendar files, Strava redirect)
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://localhost:5432/ecorun
# Generated by `npm run setup` — keep secret
JWT_SECRET=
BOT_INTERNAL_SECRET=

# ---- Telegram (create a bot with @BotFather, paste its token here) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional: channel/chat id where new public runs are announced, e.g. @ecorun_tashkent or -100123...
TELEGRAM_CHANNEL_ID=

# ---- SMS OTP (Eskiz.uz). Empty = dev mode: code is logged and shown in the app ----
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ---- Social login (optional) ----
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ---- Strava (optional) ----
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ---- Web push (generated by `npm run setup`) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ecorun.uz

# ---- Payments for paid events, phase 2 (optional) ----
PAYME_MERCHANT_ID=
CLICK_SERVICE_ID=
UZUM_MERCHANT_ID=

# Bind address. 127.0.0.1 = this computer only; 0.0.0.0 to test from a phone on your Wi-Fi (dev login codes then appear only in the server log)
HOST=127.0.0.1
